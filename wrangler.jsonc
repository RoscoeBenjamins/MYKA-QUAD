{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "myka-quad",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "directory": "./_site", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "d1_databases": [
    { "binding": "DB", "database_name": "myka-quad-db", "database_id": "5260db74-f253-42b8-80b3-477d27259a54", "migrations_dir": "db/migrations" }
  ],
  "vars": {
    "MAILER_URL": "https://script.google.com/macros/s/AKfycbwdXU-fBzbe8PSacwbOQpCakiyyNo7U2pNaHyGWIGbKubdjt9QmLnlHnh47CDHhyMdNpA/exec"
  },
  "observability": { "enabled": true }
}
