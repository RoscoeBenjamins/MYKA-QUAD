{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo \"nothing to install\"",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "_site",
  "framework": null,
  "regions": [
    "lhr1"
  ],
  "headers": [
    {
      "source": "/config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
