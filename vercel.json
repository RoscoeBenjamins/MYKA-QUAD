{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && cd source && pnpm install --frozen-lockfile",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "_site",
  "framework": null,
  "regions": [
    "lhr1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "server/**"
    }
  },
  "headers": [
    {
      "source": "/config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
